<?xml version="1.0"?>
<!--
Design Ledger for 6-DOF Robot Arm with Gripper
================================================
Frame: base_link origin at base center, bottom at z=0
Units: metres (URDF standard)
Joint convention:
  J1: waist rotation (Z)
  J2: shoulder pitch (Y)
  J3: elbow pitch (Y)
  J4: wrist roll (Z)
  J5: wrist pitch (Y)
  J6: end roll (Z)
  J_left, J_right: gripper fingers (X prismatic)
Apple target: sphere ~0.075m diameter, positioned at (0.3, 0, 0.15)
-->
<robot name="robot_arm_6dof">

  <!-- ===== Base ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.070" length="0.035"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.070" length="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ===== Joint 1: Waist (Z rotation) ===== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="2.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.0625" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.050 0.125"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0625" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.050 0.125"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0625" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ===== Joint 2: Shoulder Pitch (Y rotation) ===== -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="2.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.1375" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.040 0.275"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1375" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.040 0.275"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1375" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ===== Joint 3: Elbow Pitch (Y rotation) ===== -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.275" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="30" velocity="2.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.035 0.228"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.035 0.228"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ===== Joint 4: Wrist Roll (Z rotation) ===== -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.228" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.030 0.105"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.030 0.105"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ===== Joint 5: Wrist Pitch (Y rotation) ===== -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3.0"/>
  </joint>

  <link name="link5">
    <visual>
      <origin xyz="0 0 0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.025 0.075"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.025 0.075"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0375" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ===== Joint 6: End Roll (Z rotation) ===== -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="4.0"/>
  </joint>

  <!-- ===== Gripper Base ===== -->
  <link name="link6">
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.040 0.045"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.040 0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- ===== Gripper Joints ===== -->
  <joint name="left_gripper_joint" type="prismatic">
    <parent link="link6"/>
    <child link="left_finger"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.040" effort="10" velocity="0.1"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="-0.015 0 0.030" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.020 0.060"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="-0.015 0 0.030" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.020 0.060"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.015 0 0.030" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="right_gripper_joint" type="prismatic">
    <parent link="link6"/>
    <child link="right_finger"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.040" effort="10" velocity="0.1"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0.015 0 0.030" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.020 0.060"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 0.030" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.020 0.060"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.015 0 0.030" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

</robot>
